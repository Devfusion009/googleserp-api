HOST=127.0.0.1
PORT=8000
API_KEY=
HEADLESS=false
BROWSER_CHANNEL=chromium
BROWSER_EXECUTABLE_PATH=
CONCURRENCY=1
BLOCK_RESOURCES=true
NAV_TIMEOUT_MS=15000
AIO_APPEAR_WAIT_MS=1500
AIO_MAX_WAIT_MS=12000
AIO_CLICK_TIMEOUT_MS=4000
REQUEST_DEADLINE_MS=25000
MAX_RETRIES=0
PROXY_UNREACHABLE_RETRIES=1
GOTO_CONCURRENCY=16
GOTO_TIMEOUT_MS=3000
MIN_DELAY_SECONDS=10
STOP_ON_BLOCK=true
MAX_LIVE_REQUESTS_PER_RUN=30
PROXY_MODE=none
PROXY_URL=
PROXY_LIST_FILE=
PROXY_SESSION_MAX_SECONDS=0
# JSON with a "timezone" lets the browser take the exit IP's timezone (ipinfo.io/json, ip-api.com/json)
EXIT_IP_CHECK_URL=https://ipinfo.io/json
# Browser timezone = the exit IP's (from EXIT_IP_CHECK_URL); TIMEZONE_ID (IANA name) when the check gives none
TIMEZONE_FROM_EXIT_IP=true
TIMEZONE_ID=
TRAFFIC_BUDGET_MB=0
DEBUG_ARTIFACTS=true
ARTIFACTS_DIR=artifacts
SEARCH_MODE=url
TYPED_KEY_DELAY_MIN_MS=30
TYPED_KEY_DELAY_MAX_MS=90
